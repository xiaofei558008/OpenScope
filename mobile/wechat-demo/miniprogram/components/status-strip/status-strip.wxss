.strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.cell {
  background: #18222d;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
  min-width: 180rpx;
  flex: 1;
}

.k {
  display: block;
  color: #9aabba;
  font-size: 20rpx;
}

.v {
  display: block;
  color: #e7eef5;
  font-size: 22rpx;
  margin-top: 4rpx;
}
