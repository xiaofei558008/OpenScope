<view class="page">
  <demo-banner />
  <section-nav current="monitor" />
  <status-strip snap="{{snap}}" />
  <view class="h1">本地合成读数和波形</view>
  <view class="warn">来源 {{snap.sourceLabel}}。传输状态保持独立：播放曲线不等于已经连上 PC。离开本页会暂停并清除旧样本，回来是新的一代。没有后台保活。</view>
  <view class="muted">代数 {{snap.generation}} · 缓冲 {{snap.bufferLength}}/{{snap.bufferLimit}} · 缺口 {{snap.gapCount}} · {{snap.generatorLabel}}</view>
  <view class="row">
    <button class="btn" bindtap="onStart">播放本地合成样本</button>
    <button class="btn btn-quiet" bindtap="onStop">停止并清除</button>
    <button class="btn btn-quiet" bindtap="onGap">插入采样缺口</button>
  </view>
  <view class="card">
    <view class="reading" wx:for="{{snap.readings}}" wx:key="id">
      <text>{{item.projectName}} / {{item.moduleName}} / {{item.name}}</text>
      <text class="mono">{{item.display}} {{item.unit}}</text>
    </view>
    <view class="muted" wx:if="{{snap.readings.length === 0}}">{{snap.accessDeniedReason}}</view>
  </view>
  <view class="canvas-wrap">
    <canvas type="2d" id="wave" class="wave"></canvas>
  </view>
  <view class="muted">波形用小程序 canvas 绘制。缺口会断开线条，不会画成 0。当前变量 {{snap.selectedBounds.name}}。</view>
  <view class="notice">{{snap.notice}}</view>
</view>
