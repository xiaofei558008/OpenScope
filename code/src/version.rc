#include <windows.h>

#define IDI_APP 1
IDI_APP ICON "..\\..\\icon\\OpenScope.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,8,3,0
 PRODUCTVERSION 1,8,3,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenScope"
            VALUE "FileDescription", "OpenScope - MCU Variable Acquisition and Calibration"
            VALUE "FileVersion", "1.8.3.0"
            VALUE "InternalName", "OpenScope"
            VALUE "LegalCopyright", "Copyright (C) 2026 OpenScope"
            VALUE "OriginalFilename", "OpenScope.exe"
            VALUE "ProductName", "OpenScope"
            VALUE "ProductVersion", "1.8.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
